# ======================================================================
# SYSTECH STUDIO - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Multi-Tenant SaaS Platform for Barbershops
# ======================================================================

# ----------------------------------------------------------------------
# 1. ENTORNO Y PUERTO DEL SERVIDOR
# ----------------------------------------------------------------------
# Entorno: development | staging | production | test
NODE_ENV=development
# Puerto del servidor backend REST API
PORT=3001
# URL base pública del backend API
API_URL=http://localhost:3001/api
# URL base de la aplicación Web Frontend
APP_URL=http://localhost:5173

# ----------------------------------------------------------------------
# 2. BASE DE DATOS (PRISMA ORM)
# ----------------------------------------------------------------------
# Desarrollo local (SQLite ligero):
DATABASE_URL="file:./dev.db"

# Producción / Staging (PostgreSQL 16 administrado - Neon / Supabase / Railway / RDS):
# DATABASE_URL="postgresql://systech_user:SuperSecretPassword@db-host:5432/systech_prod?sslmode=require&schema=public"

# Redis Cache & Background Jobs (Opcional en dev, recomendado en prod):
# REDIS_URL="redis://localhost:6379"

# ----------------------------------------------------------------------
# 3. SEGURIDAD, AUTENTICACIÓN & CORS
# ----------------------------------------------------------------------
# Llave secreta para la firma y verificación de tokens JWT (Mínimo 32 caracteres criptográficos)
# Generar con: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Secreto para autenticar tareas programadas internas (cron jobs)
# Generar con: openssl rand -hex 32
CRON_SECRET=

# Lista blanca de orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.systech.mx,https://systech.mx

# ----------------------------------------------------------------------
# 4. FACTURACIÓN RECURRENTE (STRIPE BILLING) & CFDI (FACTURAPI)
# ----------------------------------------------------------------------
# Llave secreta de Stripe (sk_test_... en desarrollo, sk_live_... en producción)
STRIPE_SECRET_KEY=sk_test_51...your_test_secret_key

# Webhook Secret de Stripe para verificación de firmas criptográficas (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Llave API de FacturAPI para emisión real de CFDI 4.0 (sk_test_... / sk_live_...)
FACTURAPI_KEY=

# ----------------------------------------------------------------------
# 5. MENSAJERÍA WHATSAPP BUSINESS PLATFORM (CLOUD API META)
# ----------------------------------------------------------------------
# Identificador del número de teléfono registrado en Meta Business Suite
META_WA_PHONE_NUMBER_ID=
WHATSAPP_PHONE_NUMBER_ID=

# Token de acceso permanente del sistema de Meta Graph API
META_WA_ACCESS_TOKEN=
WHATSAPP_API_TOKEN=

# Token de verificación para el webhook de recepción de mensajes de Meta
META_WA_VERIFY_TOKEN=

# Proveedor de mensajería: META_CLOUD | SIMULATED | WA_ME_DIRECT
WHATSAPP_PROVIDER=SIMULATED

# ----------------------------------------------------------------------
# 6. CORREO ELECTRÓNICO TRANSACCIONAL
# ----------------------------------------------------------------------
# Proveedor Resend o SMTP con dominio propio (soporte@systech.mx)
RESEND_API_KEY=re_123456789_abcdefg
EMAIL_FROM=SYSTECH Studio <notificaciones@systech.mx>

# ----------------------------------------------------------------------
# 7. MONITOREO DE ERRORES & APM (SENTRY)
# ----------------------------------------------------------------------
# DSN de Sentry para captura centralizada de excepciones
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
