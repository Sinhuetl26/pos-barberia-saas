{
  "name": "systech-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@systech/api",
    "dev:web": "npm run dev --workspace=@systech/web",
    "dev": "node scripts/dev.js",
    "demo:api": "npm run build:api && node scripts/preview_local.js",
    "demo:stripe": "npm run build:api && node scripts/preview_local.js --stripe-test",
    "stripe:listen": "node scripts/stripe_listener.js",
    "stripe:verify": "npm run build:api && node scripts/verify_stripe_sandbox.js",
    "build": "npm run db:generate && npm run build:db && npm run build:api && npm run build:web",
    "build:db": "npm run build --workspace=@systech/database",
    "build:api": "npm run build --workspace=@systech/api",
    "build:web": "npm run build --workspace=@systech/web",
    "db:generate": "npm run prisma:generate --workspace=@systech/database",
    "db:migrate": "node scripts/migrate_postgres.js",
    "db:check": "node scripts/check_postgres.js",
    "db:use:postgres": "node scripts/switch_db.js postgres",
    "db:use:sqlite": "node scripts/switch_db.js sqlite",
    "test:phase0": "node scripts/run_all_tests.js phase0",
    "test:pos": "node scripts/run_all_tests.js pos-integrity",
    "test:cash": "node scripts/run_all_tests.js cash-integrity",
    "test:phase1": "node scripts/run_all_tests.js phase1",
    "test:phase2": "node scripts/run_all_tests.js phase2",
    "test:phase3": "node scripts/run_all_tests.js phase3",
    "test": "node scripts/run_all_tests.js",
    "test:postgres": "node scripts/test_postgres.js",
    "test:postgres:snapshot": "node scripts/prepare_ci_snapshot.js",
    "test:commercial": "npm run build:api && node scripts/test_commercial_foundation.js",
    "package:zip": "node scripts/create_zip.js",
    "docker:build": "docker build -t systech-api:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
