// Prisma schema for SYSTECH Barber SaaS Platform
// Multi-tenant Barber Management System - Production Ready Architecture

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Plan {
  id                String    @id @default(uuid())
  codigo            String    @unique // BASICO, PRO, ENTERPRISE
  nombre            String
  precioMensual     Decimal
  limiteSucursales  Int       @default(1)
  limiteBarberos    Int       @default(3)
  whatsappPro       Boolean   @default(false)
  analiticaAvanzada Boolean   @default(false)
  activo            Boolean   @default(true)
  fechaCreacion     DateTime  @default(now())

  tenants           Tenant[]
}

model Tenant {
  id                String       @id @default(uuid())
  nombre            String
  slug              String?      @unique
  plan              String       @default("BASICO") // BASICO, PRO, CADENA; catálogo packages/licensing
  planId            String?
  planRel           Plan?        @relation(fields: [planId], references: [id])
  estado            String       @default("ACTIVO") // ACTIVO, EN_RIESGO, SUSPENDIDO, CANCELADO
  telefono          String?
  emailContacto     String?
  direccion         String?
  logoUrl           String?
  slogan            String?
  descripcion       String?
  portadaUrl        String?
  instagram         String?
  facebook          String?
  tiktok            String?
  whatsappPublico   String?
  personalizacionWeb String? // Validated JSON presentation options; null uses legacy defaults.
  limiteSucursales  Int          @default(1) // 1 for BASICO, 999 for PRO
  limiteBarberos    Int          @default(3) // 3 for BASICO, 999 for PRO
  fechaCreacion     DateTime     @default(now())

  sucursales        Sucursal[]
  usuarios          Usuario[]
  clientes          ClienteFinal[]
  suscripcion       Suscripcion?
  productos         Producto[]
  citas             Cita[]
  ventas            Venta[]
  comisiones        Comision[]
  cortesCaja        CorteCaja[]
  kardexMovimientos KardexMovimiento[]
  notificaciones    NotificacionLog[]
  auditorias        AuditoriaLog[]
  bloqueos          BloqueoHorario[]
  proveedores       Proveedor[]
  ordenesCompra     OrdenCompra[]
  resenas           Resena[]
  consentimientos   ConsentimientoCliente[]
  listasEspera      ListaEspera[]
  movimientosCaja   MovimientoCaja[]
  membresias        ClienteMembresia[]
  pagosNomina       PagoNomina[]
  secuencias        Secuencia[]
}

model Suscripcion {
  id                   String    @id @default(uuid())
  tenantId             String    @unique
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  montoMensual         Decimal   @default(499)
  estadoPago           String    @default("active") // active, past_due, suspended, canceled
  diasGracia           Int       @default(3)
  fechaProximoCobro    DateTime?
  fechaUltimoCobro     DateTime?
  fechaSuspension      DateTime?
  // Preserve subscription metadata from 0_init; excluded from the application client.
  plan                 String    @default("BASICO") @ignore
  cancelarAlFin        Boolean   @default(false) @ignore
  reintentosFallidos   Int       @default(0) @ignore
}

model Sucursal {
  configuradaEn DateTime?
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre          String
  direccion       String?
  telefono        String?
  zonaHoraria     String       @default("America/Mexico_City")
  horarioApertura String       @default("09:00")
  horarioCierre   String       @default("20:00")
  diasLaborales   String       @default("Lunes a Sábado")
  eliminadoEn     DateTime?

  barberos        Barbero[]
  citas           Cita[]
  ventas          Venta[]
  productos       Producto[]
  cortesCaja      CorteCaja[]
  bloqueos        BloqueoHorario[]
  listasEspera    ListaEspera[]
  movimientosCaja MovimientoCaja[]

  @@index([tenantId])
}

model Usuario {
  sessionVersion Int @default(0)
  emailVerifiedAt DateTime?
  verificationRequired Boolean @default(false)
  invitationPending Boolean @default(false)
  authActions AuthAction[]
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String      @unique
  passwordHash String
  rol          String      // SUPER_ADMIN, DUENO, GERENTE, CAJERO, BARBERO
  nombre       String
  telefono     String?
  sucursalId   String?
  barberoId    String?
  sucursalesAsignadasJson String? // null: legacy sucursalId; []: no branch access
  activo       Boolean     @default(true)
  fechaAlta    DateTime    @default(now())
  eliminadoEn  DateTime?

  @@index([tenantId])
}

model Barbero {
  id                   String           @id @default(uuid())
  sucursalId           String
  sucursal             Sucursal         @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  nombre               String
  telefono             String?
  email                String?
  avatarUrl            String?
  especialidad         String?
  descripcion          String?
  visibleEnWeb         Boolean          @default(true)
  comisionServiciosPct Decimal          @default(50.0) // 50% por defecto
  comisionProductosPct Decimal          @default(10.0) // 10% por defecto
  diasDescanso         String           @default("Domingo")
  horarioInicio        String           @default("09:00")
  horarioFin           String           @default("20:00")
  activo               Boolean          @default(true)
  eliminadoEn          DateTime?

  citas                Cita[]
  ventas               Venta[]
  comisiones           Comision[]
  bloqueos             BloqueoHorario[]
  resenas              Resena[]
  listasEspera         ListaEspera[]
  pagosNomina          PagoNomina[]

  @@index([sucursalId, activo])
}

model ClienteFinal {
  sucursalOrigenId String? // New clients inherit the creating operator branch
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre            String
  telefono          String?
  email             String?
  notas             String?
  totalVisitas      Int          @default(0)
  fechaUltimaVisita DateTime?
  gastoTotal        Decimal      @default(0)
  noShows           Int          @default(0)
  fechaNacimiento   DateTime?
  notasEstilo       String?
  eliminadoEn       DateTime?

  citas             Cita[]
  ventas            Venta[]
  consentimientos   ConsentimientoCliente[]
  membresias        ClienteMembresia[]

  @@unique([tenantId, telefono])
  @@index([tenantId, telefono])
}

model Producto {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId      String?
  sucursal        Sucursal?           @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  nombre          String
  imagen          String?
  tipo            String              @default("PRODUCTO") // PRODUCTO, SERVICIO
  categoria       String              @default("General")
  duracionMinutos Int                 @default(30) // Para servicios
  sku             String?
  precioVenta     Decimal
  tasaImpuesto    Decimal             @default(0) // Porcentaje incluido en el precio final
  costo           Decimal?            @default(0)
  stockActual     Decimal             @default(0)
  stockMinimo     Decimal             @default(0)
  naturaleza     String              @default("REVENTA")
  unidad         String              @default("PIEZA")
  presentacionNombre String?
  presentacionCantidad Decimal @default(1)
  activo          Boolean             @default(true)
  eliminadoEn     DateTime?

  kardex          KardexMovimiento[]
  ventaItems      VentaItem[]

  @@index([tenantId, sucursalId])
  @@index([tenantId, tipo])
}

model Cita {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId      String
  sucursal        Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  barberoId       String
  barbero         Barbero      @relation(fields: [barberoId], references: [id])
  clienteId       String
  cliente         ClienteFinal @relation(fields: [clienteId], references: [id])
  servicioId      String?
  nombreServicio  String?
  fechaHora       DateTime
  duracionMinutos Int          @default(30)
  estado          String       @default("PENDIENTE") // PENDIENTE, CONFIRMADA, COMPLETADA, CANCELADA, NO_SHOW
  notas           String?
  tipoCorte       String?
  referencia      CitaReferencia?
  fechaCreacion   DateTime @default(now()) @ignore
  precioEstimado  Decimal?
  codigoReserva    String?
  tokenCancelacion String?      @unique
  tokenExpiraEn DateTime?
  claveReserva String?
  solicitudHash String?
  serviciosJson    String?
  bufferMinutos    Int          @default(10)

  venta           Venta?
  resena          Resena?

  @@unique([tenantId, codigoReserva])
  @@unique([tenantId, claveReserva])
  @@index([tenantId, fechaHora])
  @@index([sucursalId, barberoId, fechaHora])
}

model CitaReferencia {
  citaId String @id
  cita Cita @relation(fields: [citaId], references: [id], onDelete: Cascade)
  imagen String
}

model BloqueoHorario {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId  String
  sucursal    Sucursal  @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  barberoId   String?
  barbero     Barbero?  @relation(fields: [barberoId], references: [id])
  fechaInicio DateTime
  fechaFin    DateTime
  motivo      String    // Almuerzo, Mantenimiento, Descanso, Especial

  @@index([tenantId, sucursalId, fechaInicio, fechaFin])
  tipo String @default("BLOQUEO")
  citasAfectadasJson String?

}

model Venta {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId    String
  sucursal      Sucursal      @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  barberoId     String
  barbero       Barbero       @relation(fields: [barberoId], references: [id])
  clienteId     String?
  cliente       ClienteFinal? @relation(fields: [clienteId], references: [id])
  citaId        String?       @unique
  cita          Cita?         @relation(fields: [citaId], references: [id])
  folio             String?
  serie             String        @default("A")
  folioConsecutivo  Int           @default(1)
  estado            String        @default("COMPLETADA") // COMPLETADA, CANCELADA
  motivoCancelacion String?
  canceladoPor      String?
  subtotal          Decimal       @default(0)
  descuento     Decimal       @default(0)
  propina       Decimal       @default(0)
  total         Decimal
  impuesto      Decimal       @default(0) // Incluido en el total; excluye propina
  metodoPago    String        // EFECTIVO, TARJETA, TRANSFERENCIA, MIXTO
  detallesPago  String?       // JSON string for split payments
  fecha         DateTime      @default(now())

  items         VentaItem[]
  comisiones    Comision[]
  operacionPOS  POSOperacion?
  totalDevuelto Decimal @default(0)
  propinaDevuelta Decimal @default(0)
  cobradoPorId String?
  cobradoPorNombre String?
  corteCajaId String?
  devoluciones DevolucionVenta[]

  @@unique([tenantId, sucursalId, folio])
  @@index([tenantId, fecha])
  @@index([sucursalId, fecha])
}

model POSOperacion {
  id          String   @id @default(uuid())
  tenantId    String
  clave       String
  requestHash String
  ventaId     String?  @unique
  venta       Venta?   @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  respuesta   String?
  fecha       DateTime @default(now())

  @@unique([tenantId, clave])
}

model VentaItem {
  id             String    @id @default(uuid())
  ventaId        String
  venta          Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto  @relation(fields: [productoId], references: [id])
  nombreItem     String
  tipoItem       String    @default("PRODUCTO") // PRODUCTO, SERVICIO
  cantidad       Int       @default(1)
  precioUnitario Decimal
  subtotal       Decimal
  descuento      Decimal   @default(0)
  impuesto       Decimal   @default(0)
  tasaImpuesto   Decimal   @default(0)
  comision       Decimal   @default(0)

  @@index([ventaId])
}

model Comision {
  id                 String     @id @default(uuid())
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventaId            String
  venta              Venta      @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  barberoId          String
  barbero            Barbero    @relation(fields: [barberoId], references: [id])
  monto              Decimal
  porcentaje         Decimal    @default(0)
  pagada             Boolean    @default(false)
  fechaPago          DateTime?
  metodoPagoComision String?
  origen String @default("VENTA")
  devolucionId String?
  corteCajaId        String?
  corteCaja          CorteCaja? @relation(fields: [corteCajaId], references: [id])

  @@index([tenantId, barberoId, pagada])
}

model CorteCaja {
  id                 String     @id @default(uuid())
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId         String
  sucursal           Sucursal   @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  usuarioId          String?
  fechaApertura      DateTime   @default(now())
  fechaCierre        DateTime?
  fondoInicial       Decimal    @default(0)
  totalEfectivo      Decimal    @default(0)
  totalTarjeta       Decimal    @default(0)
  totalTransferencia Decimal    @default(0)
  totalPropinas      Decimal    @default(0)
  totalVentas        Decimal    @default(0)
  conteoEfectivoReal Decimal?
  descuadre          Decimal?
  notas              String?
  resumenJson String?
  cierreHash String?
  estado             String     @default("ABIERTO") // ABIERTO, CERRADO

  comisiones         Comision[]
  movimientos        MovimientoCaja[]

  @@index([tenantId, sucursalId, estado])
}

model KardexMovimiento {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId     String
  productoId     String
  producto       Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipoMovimiento String    // VENTA_POS, ENTRADA_COMPRA, AJUSTE_INVENTARIO, MERMA_DEVOLUCION
  cantidad       Decimal
  stockAnterior  Decimal
  stockNuevo     Decimal
  motivo         String?
  fecha          DateTime  @default(now())
  usuarioId      String?
  metadataJson   String?   // Immutable purchase cost/document/actor snapshot.

  @@index([tenantId, productoId, fecha])
}

model InventarioOperacion {
  id          String   @id @default(uuid())
  tenantId    String
  clave       String
  requestHash String
  respuesta   String?
  fecha       DateTime @default(now())
  @@unique([tenantId, clave])
}

model ConteoInventario {
  id           String   @id @default(uuid())
  tenantId     String
  sucursalId   String
  usuarioId    String
  estado       String   @default("BORRADOR")
  version      Int      @default(0)
  itemsJson    String
  motivo       String?
  fecha        DateTime @default(now())
  confirmadoEn DateTime?
  @@index([tenantId, sucursalId, fecha])
}

model NotificacionLog {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo         String    // CONFIRMACION_CITA, RECORDATORIO_24H, RECORDATORIO_2H, STOCK_MINIMO, SUSCRIPCION_RIESGO
  canal        String    // WHATSAPP, SMS, EMAIL
  destinatario String
  mensaje      String
  estado       String    @default("ENVIADO") // ENVIADO, PENDIENTE, FALLIDO
  fecha        DateTime  @default(now())

  @@index([tenantId, fecha])
}

model AuditoriaLog {
  id           String    @id @default(uuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  usuarioEmail String
  accion       String    // SUSPENDER_CUENTA, REACTIVAR_CUENTA, UPGRADE_PLAN, DOWNGRADE_PLAN, CANCELAR_CUENTA, CORTE_CAJA
  detalles     String
  fecha        DateTime  @default(now())

  @@index([tenantId, fecha])
}

// ----------------------------------------------------------------------
// NUEVOS MODELOS PARA EL ROADMAP DE PRODUCCIÓN (FASE 1)
// ----------------------------------------------------------------------

model Cupon {
  id            String    @id @default(uuid())
  tenantId      String?   // null si es cupón global del SaaS, o por tenant para sus clientes
  codigo        String    @unique
  descuentoPct  Decimal?
  descuentoFijo Decimal?
  fechaInicio   DateTime  @default(now())
  fechaFin      DateTime?
  usosMaximos   Int?
  usosActuales  Int       @default(0)
  activo        Boolean   @default(true)

  @@index([tenantId, activo])
}

model Proveedor {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre        String
  contacto      String?
  telefono      String?
  email         String?
  direccion     String?
  rfc           String?
  activo        Boolean       @default(true)
  eliminadoEn   DateTime?

  ordenesCompra OrdenCompra[]

  @@index([tenantId])
}

model OrdenCompra {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId   String
  proveedorId  String
  proveedor    Proveedor   @relation(fields: [proveedorId], references: [id])
  folio        String
  total        Decimal
  estado       String      @default("PENDIENTE") // PENDIENTE, RECIBIDA, CANCELADA
  fecha        DateTime    @default(now())
  fechaEntrega DateTime?
  notas        String?

  @@index([tenantId, proveedorId])
}

model Resena {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citaId        String?      @unique
  cita          Cita?        @relation(fields: [citaId], references: [id])
  barberoId     String
  barbero       Barbero      @relation(fields: [barberoId], references: [id])
  calificacion  Int          // 1 a 5 estrellas
  comentario    String?
  clienteNombre String?
  fecha         DateTime     @default(now())

  @@index([tenantId, barberoId])
}

model ConsentimientoCliente {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId     String
  cliente       ClienteFinal @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  canal         String       // WHATSAPP, SMS, MARKETING
  otorgado      Boolean      @default(true)
  fechaRegistro DateTime     @default(now())
  ipRegistro    String?

  @@index([tenantId, clienteId])
}

model EventoPago {
  id            String    @id @default(uuid())
  tenantId      String?
  proveedor     String    // STRIPE, MERCADOPAGO, CONEKTA
  eventId       String    @unique
  tipoEvento    String
  payload       String    // JSON
  procesado     Boolean   @default(false)
  fechaCreacion DateTime  @default(now())

  @@index([tenantId, proveedor])
}

model ClienteMembresia {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId       String
  cliente         ClienteFinal @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombrePlan      String       // Ej. "Club Elite 2 Cortes"
  cortesIncluidos Int          @default(2)
  cortesRestantes Int          @default(2)
  precioMensual   Decimal      @default(350)
  fechaInicio     DateTime     @default(now())
  fechaFin        DateTime
  activo          Boolean      @default(true)

  @@index([tenantId, clienteId, activo])
}

model ListaEspera {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId      String
  sucursal        Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  clienteNombre   String
  clienteTelefono String
  servicioId      String?
  barberoId       String?
  barbero         Barbero?     @relation(fields: [barberoId], references: [id])
  fechaDeseada    DateTime
  estado          String       @default("ACTIVO") // ACTIVO, NOTIFICADO, ATENDIDO, CANCELADO
  fechaRegistro   DateTime     @default(now())

  @@index([tenantId, sucursalId, estado])
}

model MovimientoCaja {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId   String
  sucursal     Sucursal   @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  corteCajaId  String?
  corteCaja    CorteCaja? @relation(fields: [corteCajaId], references: [id])
  tipo         String     // INGRESO, RETIRO, GASTO_MENOR
  monto        Decimal
  concepto     String
  usuarioEmail String
  fecha        DateTime   @default(now())

  @@index([tenantId, sucursalId, fecha])
}

model PagoNomina {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barberoId          String
  barbero            Barbero  @relation(fields: [barberoId], references: [id], onDelete: Cascade)
  folio              String
  folioConsecutivo   Int
  fechaLiquidacion   DateTime @default(now())
  subtotalComisiones Decimal
  adelantos          Decimal  @default(0)
  deducciones        Decimal  @default(0)
  netoPagado         Decimal
  metodoPago         String   @default("TRANSFERENCIA")
  concepto           String?
  detalles           String?  // JSON string
  usuarioLiquidador  String?

  @@unique([tenantId, folio])
  @@index([tenantId, barberoId])
}

model Secuencia {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId  String   @default("DEFAULT")
  tipo        String   // 'VENTA', 'NOMINA'
  ultimoValor Int      @default(0)
  actualizado DateTime @updatedAt

  @@unique([tenantId, sucursalId, tipo])
}

// Security actions also form a durable, encrypted transactional mail outbox.
model AuthAction {
  id String @id @default(uuid())
  userId String
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  purpose String
  tokenHash String @unique
  sessionVersion Int
  expiresAt DateTime
  consumedAt DateTime?
  encryptedToken String?
  providerMessageId String? @unique
  deliveryStatus String @default("PENDING")
  mailStatus String @default("QUEUED")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([userId, purpose])
  @@index([mailStatus, nextAttemptAt])
}
model EmailDeliveryEvent {
  id String @id
  emailId String
  status String
  occurredAt DateTime
  receivedAt DateTime @default(now())
  @@index([emailId])
}
model EmailSuppression {
  id String @id
  reason String
  createdAt DateTime @default(now())
}
model AuthThrottle {
  id String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

// Historical invoices are retained physically; the upcoming CFDI implementation owns their API.
model Factura {
  id             String @id
  tenantId       String
  ventaId        String?
  rfcEmisor      String
  rfcReceptor    String
  razonSocial    String
  regimenFiscal  String
  usoCfdi        String
  codigoPostal   String
  subtotal       Decimal
  iva            Decimal
  total          Decimal
  uuidFiscal     String? @unique
  serie          String @default("F")
  folio          String
  fechaTimbrado  DateTime?
  estado         String @default("GENERADA")
  xmlUrl         String?
  pdfUrl         String?
  errorDetalle   String?
  esPrueba       Boolean @default(true)
  fechaCreacion  DateTime @default(now())
  @@ignore
}

// Immutable financial events. Only recorded locally; no provider refund is implied.
model CajaOperacion {
  id String @id @default(uuid())
  tenantId String
  sucursalId String
  clave String
  requestHash String
  respuesta String?
  fecha DateTime @default(now())
  @@unique([tenantId, clave])
}

model RegistroCaja {
  id String @id @default(uuid())
  tenantId String
  sucursalId String
  corteCajaId String?
  ventaId String?
  tipo String
  metodoPago String
  monto Decimal
  custodiaUsuarioId String?
  usuarioId String
  usuarioNombre String
  concepto String
  fecha DateTime @default(now())
  @@index([tenantId, sucursalId, corteCajaId])
  @@index([tenantId, custodiaUsuarioId])
}

model DevolucionVenta {
  id String @id @default(uuid())
  tenantId String
  sucursalId String
  ventaId String
  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  motivo String
  usuarioId String
  usuarioNombre String
  itemsJson String
  pagosJson String
  total Decimal
  comision Decimal
  propina Decimal @default(0)
  fecha DateTime @default(now())
  @@index([tenantId, ventaId])
}

model ReservaLimite {
  id String @id
  tenantId String
  contador Int @default(0)
  expiraEn DateTime
  @@index([expiraEn])
}

model DurableJob {
  id String @id @default(uuid())
  tenantId String
  key String
  kind String
  provider String
  entityId String?
  entityVersion String?
  state String @default("QUEUED")
  attempts Int @default(0)
  maxAttempts Int @default(4)
  availableAt DateTime @default(now())
  expiresAt DateTime
  leaseToken String?
  leaseUntil DateTime?
  lastCode String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, key])
  @@index([state, availableAt])
  @@index([tenantId, provider, state])
}

model JobProviderControl {
  id String @id
  tenantId String
  provider String
  paused Boolean @default(false)
  updatedAt DateTime @updatedAt
  @@unique([tenantId, provider])
}

model JobWorkerPulse {
  id String @id
  lastSeen DateTime
  rssBytes Int
}

model RecetaServicio {
  id String @id @default(uuid())
  tenantId String
  servicioId String
  version Int
  itemsJson String
  fecha DateTime @default(now())
  usuarioId String
  @@unique([tenantId, servicioId, version])
}
model ConsumoServicio {
  id String @id @default(uuid())
  tenantId String
  sucursalId String
  servicioId String
  eventoClave String
  recetaVersion Int
  itemsJson String
  citaId String?
  ventaId String?
  usuarioId String
  fecha DateTime @default(now())
  @@unique([tenantId, eventoClave, servicioId])
  @@index([tenantId, sucursalId, fecha])
}

model FilaPresencial {
  id String @id @default(uuid())
  tenantId String
  sucursalId String
  clienteNombre String?
  clienteTelefono String?
  serviciosJson String
  barberoPreferidoId String?
  barberoId String?
  citaId String? @unique
  estado String @default("ESPERANDO")
  version Int @default(0)
  fechaLlegada DateTime @default(now())
  usuarioId String
  motivoRetiro String?
  @@index([tenantId, sucursalId, estado, fechaLlegada])
}
model OperacionAgenda {
  id String @id @default(uuid())
  tenantId String
  clave String
  requestHash String
  respuesta String?
  fecha DateTime @default(now())
  @@unique([tenantId, clave])
}
model TurnoEspecial {
  id String @id @default(uuid())
  tenantId String
  sucursalId String
  barberoId String
  fecha String
  horarioInicio String
  horarioFin String
  motivo String
  version Int @default(1)
  usuarioId String
  fechaCreacion DateTime @default(now())
  @@unique([tenantId, barberoId, fecha])
  @@index([tenantId, sucursalId, fecha])
}

model TarifaProfesional {
  id String @id @default(uuid())
  tenantId String
  sucursalId String
  barberoId String
  servicioId String
  version Int
  precio Decimal?
  vigenteDesde DateTime
  vigenteHasta DateTime?
  anulada Boolean @default(false)
  usuarioId String
  fecha DateTime @default(now())
  @@unique([tenantId, sucursalId, barberoId, servicioId, version], map: "TarifaProfesional_scope_version_key")
  @@index([tenantId, sucursalId, vigenteDesde])
}
model PoliticaDescuento {
  id String @id @default(uuid())
  tenantId String
  sucursalId String
  version Int
  activa Boolean @default(true)
  limitesJson String
  motivoObligatorio Boolean
  vigenciaAprobacionMinutos Int
  usuarioId String
  fecha DateTime @default(now())
  @@unique([tenantId, sucursalId, version])
}
model AprobacionDescuento {
  id String @id @default(uuid())
  tenantId String
  sucursalId String
  solicitadoPorId String
  rolSolicitante String
  cartHash String
  carritoJson String
  resumenJson String
  motivo String
  politicaVersion Int?
  estado String @default("PENDIENTE")
  aprobadoPorId String?
  aprobadoPorNombre String?
  aprobadoEn DateTime?
  expiraEn DateTime?
  ventaId String? @unique
  fecha DateTime @default(now())
  @@index([tenantId, sucursalId, estado, fecha])
}

model GastoOperativo {
 id String @id @default(uuid())
 tenantId String
 sucursalId String
 concepto String
 categoria String
 fecha DateTime
 importe Decimal
 metodoPago String
 comprobanteReferencia String?
 registroCajaId String? @unique
 usuarioId String
 usuarioNombre String
 version Int @default(1)
 creadoEn DateTime @default(now())
 @@index([tenantId, sucursalId, fecha])
}
model CorreccionGasto {
 id String @id @default(uuid())
 tenantId String
 sucursalId String
 gastoId String
 version Int
 registroCajaId String? @unique
 anteriorJson String
 actualJson String
 motivo String
 usuarioId String
 usuarioNombre String
 fecha DateTime @default(now())
 @@unique([gastoId, version])
 @@index([tenantId, sucursalId, gastoId])
}
